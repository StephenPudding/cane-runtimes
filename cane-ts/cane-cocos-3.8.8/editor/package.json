{
  "name": "cane-runtime",
  "version": "0.1.0-alpha.1",
  "package_version": 2,
  "title": "Cane Runtime",
  "description": "Cane skeletal animation for Cocos Creator 3.8.8.",
  "author": "Cane",
  "editor": ">=3.8.8 <=3.8.8",
  "type": "commonjs",
  "main": "./main.cjs",
  "contributions": {
    "scene": {"script":"./scene.cjs"},
    "inspector": {"section":{"node":{"cane.CaneSkeleton":"./inspector.cjs"}}},
    "asset-db": {
      "script": "./asset-db.cjs",
      "global-hook": ["beforePreStart"],
      "asset-handler": [{"name":"cane-skeleton", "handler":"registerCaneHandler", "extnames":[".json", ".caneb"]}],
      "mount": {"path":"./dist/assets", "name":"cane-runtime", "readonly":true, "visible":true}
    }
  }
}
