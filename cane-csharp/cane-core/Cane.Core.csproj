<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Cane.Core</AssemblyName>
    <RootNamespace>Cane</RootNamespace>
    <Version>0.1.0-alpha.4</Version>
    <Description>Independent, engine-neutral Cane C# animation runtime.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../README.zh-CN.md" Pack="true" PackagePath="/README.zh-CN.md" />
    <None Include="../docs/**/*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
