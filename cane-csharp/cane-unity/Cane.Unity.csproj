<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Cane.Unity</AssemblyName>
    <RootNamespace>Cane.Unity</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <DefineConstants Condition="'$(CaneUnityEntityIds)' == 'true'">$(DefineConstants);UNITY_6000_4_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime/**/*.cs" Exclude="Runtime/URP/**/*.cs;Runtime/HDRP/**/*.cs" />
    <ProjectReference Include="../cane-core/Cane.Core.csproj" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityEditorRoot)/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScriptingModule" Condition="Exists('$(UnityEditorRoot)/Data/Managed/UnityEngine/UnityEngine.ScriptingModule.dll')"><HintPath>$(UnityEditorRoot)/Data/Managed/UnityEngine/UnityEngine.ScriptingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(UnityEditorRoot)/Data/Managed/UnityEngine/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireRealUnityAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityEditorRoot)/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll')" Text="UnityEditorRoot must identify a real Unity Editor directory. Compile-only evidence is not engine acceptance." />
  </Target>
</Project>
